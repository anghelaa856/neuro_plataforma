# Plantilla de variables de entorno (no subir secretos reales).
# Copia a `.env` en local. En Hugging Face → Settings → Variables and secrets.

APP_ENV=development

# Neon / PostgreSQL (obligatorio)
# Preferir connection string con POOLER de Neon para muchos alumnos concurrentes:
#   …-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Pool local de psycopg2 dentro del contenedor (no confundir con Neon pooler)
PG_POOL_MIN=1
PG_POOL_MAX=12

# OpenRouter (Mis Guías / Banco Admin)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:3005
OPENROUTER_APP_NAME=Neuro Plataforma

# --- Solo producción / HF Spaces (opcional) ---
# Si el Space no inyecta SPACE_HOST a tiempo, fija la URL pública:
# PUBLIC_APP_URL=https://TU-USUARIO-TU-SPACE.hf.space
# PORT=7860
# BACKEND_PORT=8000
# REFLEX_REDIS_URL=redis://127.0.0.1:6379
