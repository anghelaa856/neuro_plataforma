# Puerto público único (HF Spaces → 7860). Internamente:
#   frontend estático → /srv
#   backend Reflex    → 127.0.0.1:8000  (/_event, /ping, uploads…)
#
# {$PORT} lo inyecta el entrypoint / Dockerfile (default 7860).

{
	auto_https off
	admin off
}

:{$PORT:7860} {
	encode gzip zstd

	# Simulacros + subida de guías PDF pueden generar cuerpos grandes / waits largos
	request_body {
		max_size 64MB
	}

	@backend path /_event /_event/* /ping /_upload /_upload/* /_health /_all_routes /auth-codespace

	handle @backend {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:8000} {
			# Ingesta OpenRouter / bloques largos: no cortar el WebSocket
			transport http {
				read_timeout 45m
				write_timeout 45m
				dial_timeout 10s
			}
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Clientes con caché agresiva aún piden el antiguo Streamlit (/_stcore/stream).
	# Responder 410 evita “Connecting…” infinito hacia un protocolo inexistente.
	@legacy_streamlit path /_stcore /_stcore/*
	handle @legacy_streamlit {
		respond "This Space now runs Reflex (not Streamlit). Hard-refresh or clear site data." 410
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Evita servir HTML/JS obsoleto desde caché del navegador tras redeploy
		@immutable path *.js *.css *.woff2
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache, no-store, must-revalidate"
		header /env.json Cache-Control "no-cache, no-store, must-revalidate"
	}

	header {
		# Endurecimiento básico (HF ya termina TLS en el edge)
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
